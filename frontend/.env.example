# Frontend environment variables. Copy to .env.local for local development
# and set the same names in the Vercel project for preview/production.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time,
# so a missing one breaks the deployed site silently; redeploy after changes.
# Placeholders only; never commit real values.

# --- Required ---------------------------------------------------------------

# Backend base URL (FastAPI). Required: sign-in, the map, chat and reports
# have no fallback and fail without it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project URL and anon key (sign-in and session).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Mapbox public token (pk.*) for the satellite map and address search.
# The backend needs the same value as MAPBOX_ACCESS_TOKEN for county lookups.
NEXT_PUBLIC_MAPBOX_TOKEN=<mapbox-public-token>

# --- Optional ---------------------------------------------------------------

# Set to "true" to show the listing marketplace (off by default).
# NEXT_PUBLIC_ENABLE_LISTING_MARKETPLACE=false
