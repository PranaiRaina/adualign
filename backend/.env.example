# Backend environment variables. Copy to .env for local development and set
# the same names on the Railway service for production. Placeholders only;
# never commit real values.

# --- Required ---------------------------------------------------------------

# Supabase Postgres connection string (pooler URL).
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
# Supabase project URL and anon key (auth + client).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# LLM calls (OpenRouter) and embeddings (Gemini).
OPENROUTER_API_KEY=<openrouter-key>
GEMINI_API_KEY=<gemini-key>

# Parcel boundaries for /analyze.
REPORTALL_API_KEY=<reportall-key>

# County reverse geocoding for /analyze. Without it the county is blank and
# cost estimates fall back to a 1.0x county multiplier. Local dev also reads
# NEXT_PUBLIC_MAPBOX_TOKEN from ../ADYou2-Frontend/.env.local, but production
# only sees this service's variables, so set it explicitly there.
MAPBOX_ACCESS_TOKEN=<mapbox-public-token>

# Upstash Redis (map cache, rate limits, LLM budget reservations).
UPSTASH_REDIS_REST_URL=https://<instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-token>

# Web search fallback in the RAG pipeline.
SERPER_API_KEY=<serper-key>

# Shared secret for the Supabase cron call to /internal/usage-resets/run.
CRON_SECRET=<openssl rand -hex 32>

# --- Optional ---------------------------------------------------------------

# Only needed if Supabase issues HS256 tokens (ES256 uses JWKS).
# SUPABASE_JWT_SECRET=
# Comma-separated extra CORS origins added to the defaults in api/main.py.
# CORS_ALLOWED_ORIGINS=
# local | production (production disables the local debug log file).
# APP_ENV=local
# Redis read timeout; raise on slow networks (default 1000).
# REDIS_READ_TIMEOUT_MS=1000
# LangSmith tracing.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=
